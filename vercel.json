{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/browser.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/browser/stream", "destination": "/api/browser.ts" },
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/test-page", "destination": "/api/index.ts" }
  ]
}
